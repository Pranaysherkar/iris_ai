# Supabase — used by the Next.js frontend (safe to expose: anon key + project URL).
# Copy this file to .env.local and fill in values from Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site origin (no trailing slash). Used for email confirmation / OAuth redirect URLs.
# Local: http://localhost:3000  |  Production: https://your-domain.com
# Add the same URLs under Supabase → Authentication → URL Configuration → Redirect URLs.
# Include auth flows, for example:
#   http://localhost:3000/auth/signin
#   http://localhost:3000/auth/signin?email_confirmed=1
#   http://localhost:3000/auth/reset-password
#   http://localhost:3000/auth/callback
#   https://your-domain.com/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI backend (no trailing slash). Used for chat streaming.
NEXT_PUBLIC_API_URL=http://localhost:8000
