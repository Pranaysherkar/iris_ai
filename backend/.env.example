# =============================================================================
# Copy to ".env" and replace placeholders with your real keys and URLs.
# =============================================================================

# --- App ---
APP_NAME="Iris AI"
DEBUG=True
# Optional: pin Python for deploy platforms (e.g. Render). Not read by the FastAPI app.
PYTHON_VERSION=3.12

# Browser origins allowed to call the API (comma-separated, no spaces after commas).
# Local dev: leave empty = allow any origin. Production: set your frontend URL(s).
CORS_ORIGINS=

# --- Supabase (Dashboard → Project Settings → API) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Qdrant ---
QDRANT_URL="https://YOUR_CLUSTER.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION=iris_document_chunks

# --- RAG / document attachments ---
RAG_ENABLED=true
SUPABASE_STORAGE_BUCKET=attachments
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_TIER=agentic
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=220
RAG_TOP_K=6
RAG_MAX_UPLOAD_BYTES=52428800
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- AI: Groq (chat) ---
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TOP_P=0.9

# --- AI: Gemini (embeddings + vision fallback for RAG) ---
GEMINI_API_KEY=

# --- Chat guardrails (defaults match app; override only if needed) ---
CHAT_MAX_MESSAGE_CHARS=32000
CHAT_MAX_MESSAGES_PER_REQUEST=50
CHAT_MAX_CONTEXT_TOKENS_ESTIMATE=12000
CHAT_MEMORY_WINDOW=30
QUERY_PREPROCESSOR_ENABLED=true
USER_FACTS_ENABLED=true
USER_FACTS_CACHE_TTL_SECONDS=60
CONVERSATION_SUMMARY_ENABLED=true
# Optional: full override of the default chat system prompt (persona, tone, rules).
# CHAT_SYSTEM_PROMPT="You are Iris AI..."

# After the first user + first assistant message, Groq generates a short sidebar title.
CHAT_AI_TITLE_ENABLED=true
CHAT_TITLE_MAX_WORDS=4
# Max edit versions per user message (sibling branches).
CONVERSATION_BRANCH_LIMIT=3

# --- HTTP timeouts (seconds) ---
SUPABASE_HTTP_TIMEOUT_SECONDS=30
GROQ_HTTP_TIMEOUT_SECONDS=300

# --- Rate limiting (POST /api/v1/chat) ---
# Max requests per user per rolling 60s window. Set to 0 to disable.
CHAT_RATE_LIMIT_PER_MINUTE=45
# Optional: same limit shared across all server workers (install Redis, then set URL).
# Local Redis example: redis://localhost:6379/0
# Leave empty to use in-memory limiting (per process only).
REDIS_URL=

# --- Optional: OpenAI Moderations (checks user message before Groq; needs OpenAI key) ---
CHAT_MODERATION_ENABLED=true
CHAT_MODERATION_MODEL=omni-moderation-latest
# When true (default), chat continues if OpenAI moderation is rate-limited or down.
CHAT_MODERATION_FAIL_OPEN=true
OPENAI_API_KEY="API Key"

# --- Tool calls (optional live-data pipeline; see backend/docs/TOOL_CALLS_ROADMAP.md) ---
TOOLS_ENABLED=true
# llm = Groq native tool calling (recommended). regex = legacy pattern matching.
TOOL_ROUTER_MODE=llm
TOOL_ROUTER_MODEL=llama-3.3-70b-versatile
TOOL_ROUTER_TIMEOUT_SECONDS=20
TOOL_INTENT_CONFIDENCE_THRESHOLD=0.85
OLLAMA_API_KEY=
OLLAMA_WEB_SEARCH_BASE_URL=https://ollama.com
TOOL_HTTP_TIMEOUT_SECONDS=30
TOOL_DATETIME_ENABLED=true
TOOL_WEATHER_ENABLED=true
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
TOOL_WEB_SEARCH_ENABLED=false
TOOL_WEB_FETCH_ENABLED=false
# Top-N hits (1–10). Snippets are truncated; total tool block is budget-capped for Groq TPM.
TOOL_WEB_SEARCH_MAX_RESULTS=10
TOOL_WEB_SEARCH_SNIPPET_CHARS=400
TOOL_WEB_SEARCH_MAX_CONTEXT_TOKENS=3500
TOOL_WIKIPEDIA_ENABLED=true
TOOL_NEWS_RSS_ENABLED=true
TOOL_EXCHANGE_RATES_ENABLED=true
TOOL_USER_MEMORY_ENABLED=true
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
FRANKFURTER_API_URL=https://api.frankfurter.app
TOOL_NEWS_RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml

# Optional SMTP / email provider key (not used by core chat yet; keep if your deploy expects it).
SMTP_API_KEY=

# --- Speech / voice chat — English only (en-IN) ---
SPEECH_LANGUAGE=en-IN
SPEECH_ENABLED=true
SPEECH_HTTP_TIMEOUT_SECONDS=60
SPEECH_SKIP_MODERATION=true
SPEECH_CLIENT_TRANSCRIPT_ENABLED=false
VOICE_MAX_TOKENS=512
VOICE_TTS_MIN_SENTENCE_CHARS=6
VOICE_TTS_MAX_PHRASE_CHARS=48
VOICE_TOOLS_ENABLED=true
GROQ_VOICE_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

SARVAM_API_KEY=your-sarvam-key
SARVAM_STT_ENABLED=true
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=en-IN
SARVAM_STT_MODE=transcribe

SARVAM_TTS_ENABLED=true
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_OUTPUT_CODEC=wav

TTS_FALLBACK_EDGE_ENABLED=true
EDGE_TTS_VOICE=en-IN-PrabhatNeural
EDGE_TTS_RATE=+0%